{
  "name": "km-sin-sidebar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build": "npm run typecheck && vite build && node scripts/postbuild.mjs",
    "test": "vitest run",
    "validate": "npm run typecheck && npm run test && npm run build"
  },
  "overrides": {
    "minimatch": "^3.1.4",
    "brace-expansion": "^1.1.18"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/tampermonkey": "^5.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-monkey": "^8.1.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
